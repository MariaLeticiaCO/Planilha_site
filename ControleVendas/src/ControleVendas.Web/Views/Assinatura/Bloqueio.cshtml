@model AssinaturaStatusDto
@{ ViewData["Title"] = "Renove para continuar vendendo"; }
<div class="card mx-auto mt-6 max-w-lg p-6 text-center sm:p-8">
    <span class="mx-auto inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-rose-100 text-rose-600">@Icone.Svg("cadeado", "w-7 h-7")</span>
    <h1 class="mt-4 text-xl font-extrabold">@(Model.Plano == Plano.TESTE ? "Seu teste grátis acabou" : "Sua assinatura venceu")</h1>
    <p class="mt-2 text-slate-600">Seus dados estão guardados e você continua vendo o painel. Para registrar vendas novas, escolha um plano.</p>
    @if (User.IsInRole("DONO"))
    {
        <a href="/assinatura" class="btn-primario btn-lg mt-6 w-full">Renovar agora</a>
    }
    else
    {
        <p class="mt-6 rounded-xl bg-slate-50 p-3 text-sm text-slate-600">Avise o dono da conta para renovar a assinatura.</p>
    }
    <a href="/painel" class="btn-secundario mt-3 w-full">Ver o painel</a>
</div>
