@model IReadOnlyList<PlanoInfo>
@{
    ViewData["Title"] = "Assinatura";
    var status = (AssinaturaStatusDto)ViewBag.Status;
    var historico = (IReadOnlyList<PagamentoGatewayDto>)ViewBag.Historico;
    string NomePlano(Plano p) => p switch { Plano.TESTE => "Teste grátis", Plano.BASICO => "Básico", _ => "Pro" };
}
<h1 class="titulo-pagina">Assinatura</h1>

@* Plano atual *@
<div class="mt-4 rounded-2xl p-5 text-white shadow-lg @(status.Ativa ? "bg-gradient-to-br from-marca-600 to-marca-800 shadow-marca-600/25" : "bg-gradient-to-br from-rose-500 to-rose-700")">
    <p class="text-sm font-semibold text-white/80">Plano atual</p>
    <div class="mt-1 flex flex-wrap items-center gap-2">
        <p class="text-2xl font-extrabold">@NomePlano(status.Plano)</p>
        <span class="chip bg-white/20 text-white">@(status.Ativa ? "Ativo" : "Vencido")</span>
    </div>
    <p class="mt-1 text-sm text-white/90">
        @if (status.Plano == Plano.TESTE)
        {
            @(status.Ativa ? $"Faltam {status.DiasRestantesTrial} {(status.DiasRestantesTrial == 1 ? "dia" : "dias")} de teste (até {Exibir.Data(status.DataFimTrial)})." : $"O teste acabou em {Exibir.Data(status.DataFimTrial)}.")
        }
        else if (status.DataFimAssinatura is not null)
        {
            @($"{(status.Status == StatusAssinatura.CANCELADA ? "Cancelada; vale" : "Válida")} até {Exibir.Data(status.DataFimAssinatura.Value)}.")
        }
        else
        {
            <text>Pagamento único — sem mensalidade.</text>
        }
    </p>
</div>

@if (status.GatewaySimulado)
{
    <div class="mt-4 rounded-xl border border-amber-200 bg-amber-50 p-3 text-sm text-amber-900">
        <b>Modo de desenvolvimento:</b> o Asaas não está configurado (Asaas:ApiKey). As cobranças são simuladas e você pode confirmar o pagamento na tela seguinte.
    </div>
}

@* Comparação de planos *@
<h2 class="mt-8 text-lg font-bold">Escolha seu plano</h2>
<div class="mt-3 grid gap-4 md:grid-cols-3">
    @foreach (var p in Model)
    {
        var atual = (p.Plano == status.Plano && status.Ativa && (p.Opcao != OpcaoPlano.PRO_ANUAL || status.Plano != Plano.PRO));
        var destaque = p.Opcao == OpcaoPlano.PRO_ANUAL;
        <form method="post" asp-antiforgery="true" action="/assinatura" class="flex flex-col rounded-2xl p-5 @(destaque ? "bg-white ring-2 ring-marca-600 shadow-lg" : "card")">
            <input type="hidden" name="Opcao" value="@p.Opcao" />
            <div class="flex items-center justify-between">
                <h3 class="font-bold">@p.Nome</h3>
                @if (destaque) { <span class="chip-marca">Melhor preço</span> }
            </div>
            <p class="mt-2"><span class="text-3xl font-extrabold">@Exibir.Moeda(p.Preco)</span> <span class="text-sm text-slate-500">@p.Periodicidade</span></p>
            <ul class="mt-4 flex-1 space-y-1.5 text-sm text-slate-600">
                @foreach (var item in p.Inclui) { <li class="flex gap-2"><span class="text-emerald-600">@Icone.Svg("check", "w-4 h-4")</span>@item</li> }
            </ul>
            @if (!status.GatewaySimulado)
            {
                <label class="mt-4 block">
                    <span class="rotulo text-xs">CPF ou CNPJ (para a nota da cobrança)</span>
                    <input name="CpfCnpj" class="campo" data-mascara="documento" inputmode="numeric" required />
                </label>
            }
            <div class="mt-4 grid grid-cols-2 gap-2">
                <button name="Forma" value="PIX" class="btn-primario">@Icone.Svg("pix", "w-4 h-4") Pix</button>
                <button name="Forma" value="CARTAO" class="btn-secundario">@Icone.Svg("cartao", "w-4 h-4") Cartão</button>
            </div>
        </form>
    }
</div>

@* Histórico de pagamentos *@
<h2 class="mt-8 text-lg font-bold">Histórico de pagamentos</h2>
<div class="card mt-3 divide-y divide-slate-100">
    @if (historico.Count == 0) { <p class="p-6 text-center text-sm text-slate-500">Nenhum pagamento ainda.</p> }
    @foreach (var pg in historico)
    {
        <div class="flex items-center justify-between gap-3 p-4 text-sm">
            <div><p class="font-semibold">@pg.Descricao</p><p class="text-xs text-slate-500">@Exibir.Data(pg.Data)</p></div>
            <div class="text-right">
                <p class="font-bold">@Exibir.Moeda(pg.Valor)</p>
                @if (pg.Status == "Aguardando pagamento" && pg.LinkPagamento is not null) { <a href="@pg.LinkPagamento" target="_blank" rel="noopener" class="text-xs font-semibold text-marca-700">Pagar</a> }
                else { <span class="@(pg.Status == "Pago" ? "chip-verde" : "chip-cinza")">@pg.Status</span> }
            </div>
        </div>
    }
</div>
