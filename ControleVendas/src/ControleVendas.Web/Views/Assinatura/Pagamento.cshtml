@model CobrancaGatewayDto
@{
    ViewData["Title"] = "Pagamento";
    var plano = (PlanoInfo)ViewBag.Plano;
    var status = (AssinaturaStatusDto)ViewBag.Status;
}
<div class="mx-auto max-w-md">
    <a href="/assinatura" class="inline-flex items-center gap-1 text-sm font-semibold text-slate-500 hover:text-slate-800">@Icone.Svg("esquerda", "w-4 h-4") Voltar aos planos</a>
    <div class="card mt-3 p-6 text-center">
        <p class="text-sm text-slate-500">@plano.Nome</p>
        <p class="text-3xl font-extrabold">@Exibir.Moeda(plano.Preco)</p>
        <p class="mt-4 font-semibold">Pague com Pix</p>
        @if (!string.IsNullOrEmpty(Model.PixQrCodeBase64))
        {
            <img src="data:image/png;base64,@Model.PixQrCodeBase64" alt="QR Code Pix" class="mx-auto mt-3 h-56 w-56" />
        }
        else
        {
            <div class="mx-auto mt-3 flex h-56 w-56 items-center justify-center rounded-2xl bg-slate-100 text-slate-400">@Icone.Svg("pix", "w-16 h-16")</div>
        }
        @if (!string.IsNullOrEmpty(Model.PixCopiaECola))
        {
            <label class="rotulo mt-4 text-left" for="copia-cola">Pix copia e cola</label>
            <div class="flex gap-2">
                <input id="copia-cola" readonly value="@Model.PixCopiaECola" class="campo text-xs" />
                <button type="button" class="btn-suave shrink-0" onclick="navigator.clipboard.writeText(document.getElementById('copia-cola').value).then(() => App.toast('Código copiado!'))">@Icone.Svg("copiar", "w-4 h-4") Copiar</button>
            </div>
        }
        <p class="mt-4 text-sm text-slate-500">Assim que o pagamento for confirmado, seu plano é liberado automaticamente. Pode fechar esta tela.</p>
        @if (Model.LinkPagamento is not null) { <a href="@Model.LinkPagamento" target="_blank" rel="noopener" class="btn-secundario mt-4 w-full">Abrir fatura</a> }
        @if (status.GatewaySimulado)
        {
            <form method="post" asp-antiforgery="true" action="/assinatura/simular" class="mt-4">
                <input type="hidden" name="opcao" value="@plano.Opcao" />
                <button class="btn-primario w-full">Simular pagamento confirmado (desenvolvimento)</button>
            </form>
        }
    </div>
</div>
