@model CadastroDto
@{
    Layout = "_LayoutAuth";
    ViewData["Title"] = "Criar conta";
}
<h1 class="text-2xl font-extrabold text-slate-900">Teste grátis por 7 dias</h1>
<p class="mt-1 text-sm text-slate-500">Sem cartão. Tudo do plano Pro liberado.</p>

<form method="post" asp-antiforgery="true" action="/cadastro" class="mt-6 space-y-4" novalidate>
    <div asp-validation-summary="ModelOnly"></div>
    <div>
        <label asp-for="Nome" class="rotulo">Seu nome</label>
        <input asp-for="Nome" class="campo" autocomplete="name" autofocus />
        <span asp-validation-for="Nome" class="erro-campo"></span>
    </div>
    <div>
        <label asp-for="Email" class="rotulo">E-mail</label>
        <input asp-for="Email" type="email" class="campo" autocomplete="email" inputmode="email" />
        <span asp-validation-for="Email" class="erro-campo"></span>
    </div>
    <div>
        <label asp-for="WhatsApp" class="rotulo">WhatsApp</label>
        <input asp-for="WhatsApp" class="campo" autocomplete="tel" inputmode="tel" data-mascara="telefone" placeholder="(11) 98765-4321" />
        <span asp-validation-for="WhatsApp" class="erro-campo"></span>
    </div>
    <div class="grid gap-4 sm:grid-cols-2">
        <div>
            <label asp-for="Senha" class="rotulo">Senha</label>
            <input asp-for="Senha" class="campo" autocomplete="new-password" />
            <span asp-validation-for="Senha" class="erro-campo"></span>
        </div>
        <div>
            <label asp-for="ConfirmarSenha" class="rotulo">Confirme a senha</label>
            <input asp-for="ConfirmarSenha" class="campo" autocomplete="new-password" />
            <span asp-validation-for="ConfirmarSenha" class="erro-campo"></span>
        </div>
    </div>
    <p class="dica -mt-2">Mínimo de 8 caracteres, com letras e números.</p>
    <div>
        <label class="flex items-start gap-2.5 text-sm text-slate-600">
            <input asp-for="AceiteTermos" data-val-required="É preciso aceitar os termos de uso e a política de privacidade." class="mt-0.5 h-4 w-4 rounded border-slate-300 text-marca-600 focus:ring-marca-500" />
            <span>Li e aceito os <a href="/termos" target="_blank" class="font-semibold text-marca-700 underline">termos de uso</a> e a <a href="/privacidade" target="_blank" class="font-semibold text-marca-700 underline">política de privacidade</a>.</span>
        </label>
        <span asp-validation-for="AceiteTermos" class="erro-campo"></span>
    </div>
    <button type="submit" class="btn-primario btn-lg w-full">Criar minha conta</button>
</form>
<p class="mt-5 text-center text-sm text-slate-600">Já tem conta? <a href="/login" class="font-semibold text-marca-700">Entrar</a></p>
