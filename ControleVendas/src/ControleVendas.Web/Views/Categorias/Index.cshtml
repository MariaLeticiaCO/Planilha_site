@model IReadOnlyList<CategoriaDto>
@{ ViewData["Title"] = "Categorias"; }
<h1 class="titulo-pagina">Categorias</h1>
<p class="subtitulo">Agrupe seus produtos para filtrar e ver o lucro por categoria.</p>

<form method="post" asp-antiforgery="true" action="/categorias" class="card-p mt-4 flex gap-2">
    <input name="nome" class="campo" placeholder="Nova categoria" maxlength="60" required aria-label="Nome da nova categoria" />
    <button class="btn-primario shrink-0">@Icone.Svg("mais") Criar</button>
</form>

<ul class="card mt-4 divide-y divide-slate-100">
    @if (Model.Count == 0) { <li class="p-6 text-center text-slate-500">Nenhuma categoria ainda.</li> }
    @foreach (var c in Model)
    {
        <li class="p-3 sm:p-4 @(c.Ativo ? "" : "bg-slate-50")">
            <div class="flex items-center gap-3" id="cat-@c.Id">
                <div class="min-w-0 flex-1">
                    <p class="truncate font-semibold @(c.Ativo ? "" : "text-slate-400 line-through")">@c.Nome</p>
                    <p class="text-xs text-slate-500">@c.QtdProdutos @(c.QtdProdutos == 1 ? "produto ativo" : "produtos ativos")</p>
                </div>
                <button type="button" class="btn-secundario btn-sm" data-renomear="@c.Id">Renomear</button>
                <form method="post" asp-antiforgery="true" action="/categorias/@c.Id/ativo">
                    <input type="hidden" name="ativo" value="@(!c.Ativo ? "true" : "false")" />
                    <button class="btn-sm btn @(c.Ativo ? "text-slate-500 hover:bg-slate-100" : "btn-suave")">@(c.Ativo ? "Desativar" : "Reativar")</button>
                </form>
            </div>
            <form method="post" asp-antiforgery="true" action="/categorias/@c.Id/renomear" class="oculto mt-2 flex gap-2" id="renomear-@c.Id">
                <input name="nome" value="@c.Nome" class="campo" maxlength="60" required aria-label="Novo nome" />
                <button class="btn-primario btn-sm">Salvar</button>
            </form>
        </li>
    }
</ul>

@section Scripts {
<script>
$(document).on('click', '[data-renomear]', function () {
  const id = $(this).data('renomear');
  $('#renomear-' + id).toggleClass('oculto').find('input').trigger('focus').trigger('select');
});
</script>
}
