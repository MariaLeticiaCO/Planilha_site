@model ClienteDetalheDto
@{
    ViewData["Title"] = Model.Cliente.Nome;
    var c = Model.Cliente;
}
<div class="flex items-center gap-3">
    <a href="/clientes" class="rounded-xl p-2 text-slate-500 hover:bg-slate-100" aria-label="Voltar">@Icone.Svg("esquerda")</a>
    <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-marca-100 font-bold text-marca-700">@Exibir.Iniciais(c.Nome)</span>
    <div class="min-w-0 flex-1">
        <h1 class="titulo-pagina truncate">@c.Nome</h1>
        <p class="subtitulo">@(string.IsNullOrEmpty(c.Telefone) ? "Sem telefone" : Exibir.Telefone(c.Telefone))@(c.Documento is not null ? " · " + c.Documento : "")</p>
    </div>
    <a href="/clientes/@c.Id/editar" class="btn-secundario btn-sm">@Icone.Svg("lapis", "w-4 h-4") <span class="hidden sm:inline">Editar</span></a>
</div>
@if (!string.IsNullOrEmpty(c.Observacao)) { <p class="mt-3 rounded-xl bg-amber-50 p-3 text-sm text-amber-900">@c.Observacao</p> }

<div class="mt-4 grid grid-cols-2 gap-3">
    <div class="card-p"><p class="text-xs font-semibold uppercase text-slate-500">Comprou no total</p><p class="mt-1 text-xl font-extrabold">@Exibir.Moeda(Model.TotalComprado)</p></div>
    <div class="card-p"><p class="text-xs font-semibold uppercase text-slate-500">Deve no crediário</p><p class="mt-1 text-xl font-extrabold @(Model.TotalDevido > 0 ? "text-rose-600" : "")">@Exibir.Moeda(Model.TotalDevido)</p></div>
</div>

<div class="mt-4 grid gap-4 lg:grid-cols-2">
    <section class="card overflow-hidden">
        <h2 class="border-b border-slate-100 px-4 py-3 font-bold">Parcelas</h2>
        <ul class="divide-y divide-slate-100">
            @if (Model.Parcelas.Count == 0) { <li class="p-6 text-center text-sm text-slate-500">Nenhuma parcela.</li> }
            @foreach (var p in Model.Parcelas)
            {
                <li class="flex items-center justify-between gap-2 px-4 py-3 text-sm">
                    <div>
                        <p class="font-semibold">@Exibir.Moeda(p.Valor) <span class="font-normal text-slate-500">· @p.Numero/@p.TotalParcelas</span></p>
                        <p class="text-xs text-slate-500">Vence @Exibir.Data(p.DataVencimento) · <a class="text-marca-700" href="/vendas/@p.VendaId">venda nº @p.VendaId</a></p>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="@Exibir.ClasseSituacao(p.Situacao)">@Exibir.NomeSituacao(p.Situacao)</span>
                        @if (p.Situacao != "PAGA")
                        {
                            <a href="/crediario/@p.Id/cobrar" target="_blank" rel="noopener" class="rounded-lg p-1.5 text-emerald-600 hover:bg-emerald-50" title="Cobrar no WhatsApp">@Icone.Svg("whatsapp", "w-5 h-5")</a>
                        }
                    </div>
                </li>
            }
        </ul>
    </section>
    <section class="card overflow-hidden">
        <h2 class="border-b border-slate-100 px-4 py-3 font-bold">Histórico de compras</h2>
        <ul class="divide-y divide-slate-100">
            @if (Model.Compras.Count == 0) { <li class="p-6 text-center text-sm text-slate-500">Nenhuma compra registrada.</li> }
            @foreach (var v in Model.Compras)
            {
                <li>
                    <a href="/vendas/@v.Id" class="flex items-center justify-between gap-2 px-4 py-3 text-sm hover:bg-slate-50">
                        <div><p class="font-semibold">Venda nº @v.Id</p><p class="text-xs text-slate-500">@Exibir.DataHora(v.DataVenda) · @v.FormaPagamento</p></div>
                        <span class="font-bold @(v.Status == StatusVenda.CANCELADA ? "text-slate-400 line-through" : "")">@Exibir.Moeda(v.Total)</span>
                    </a>
                </li>
            }
        </ul>
    </section>
</div>

@if (Model.TotalDevido == 0)
{
    <form method="post" asp-antiforgery="true" action="/clientes/@c.Id/desativar" class="mt-4" data-confirmar="Remover @c.Nome da lista de clientes? O histórico de vendas continua.">
        <button class="text-sm font-semibold text-rose-600 hover:underline">Remover cliente da lista</button>
    </form>
}
