@model IReadOnlyList<ClienteListaDto>
@{ ViewData["Title"] = "Clientes"; }
<div class="flex items-center justify-between gap-3">
    <div>
        <h1 class="titulo-pagina">Clientes</h1>
        <p class="subtitulo">@Model.Count @(Model.Count == 1 ? "cliente" : "clientes")</p>
    </div>
    <a href="/clientes/novo" class="btn-primario">@Icone.Svg("mais") Cliente</a>
</div>

<form method="get" class="mt-4" data-sem-trava>
    <label class="relative block">
        <span class="pointer-events-none absolute inset-y-0 left-3.5 flex items-center text-slate-400">@Icone.Svg("busca")</span>
        <input type="search" name="busca" value="@ViewBag.Busca" class="campo pl-11" placeholder="Buscar por nome ou telefone" />
    </label>
</form>

<div class="card mt-4 divide-y divide-slate-100">
    @if (Model.Count == 0) { <p class="p-8 text-center text-slate-500">Nenhum cliente encontrado.</p> }
    @foreach (var c in Model)
    {
        <a href="/clientes/@c.Id" class="flex items-center gap-3 p-3 hover:bg-slate-50 sm:p-4">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-marca-50 text-sm font-bold text-marca-700">@Exibir.Iniciais(c.Nome)</span>
            <div class="min-w-0 flex-1">
                <p class="truncate font-semibold">@c.Nome</p>
                <p class="text-xs text-slate-500">@(string.IsNullOrEmpty(c.Telefone) ? "Sem telefone" : Exibir.Telefone(c.Telefone))</p>
            </div>
            @if (c.TotalDevido > 0)
            {
                <div class="text-right">
                    <p class="text-xs text-slate-500">deve</p>
                    <p class="font-bold @(c.TotalAtrasado > 0 ? "text-rose-600" : "text-slate-900")">@Exibir.Moeda(c.TotalDevido)</p>
                </div>
            }
            <span class="text-slate-300">@Icone.Svg("direita", "w-4 h-4")</span>
        </a>
    }
</div>
