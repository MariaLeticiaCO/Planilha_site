@{
    ViewData["Title"] = "Crediário";
    string aba = ViewBag.Aba;
    var resumo = (ResumoCrediarioDto)ViewBag.Resumo;
    var parcelas = ViewBag.Parcelas as IReadOnlyList<ParcelaDto>;
    var devedores = ViewBag.Devedores as IReadOnlyList<DevedorDto>;
    var abas = new (string Chave, string Nome)[] { ("atrasadas", "Atrasadas"), ("a-vencer", "A vencer"), ("pagas", "Pagas"), ("clientes", "Por cliente") };
}
<h1 class="titulo-pagina">Crediário</h1>
<p class="subtitulo">O fiado organizado, com cobrança pronta no WhatsApp.</p>

@* Cards de resumo *@
<div class="mt-4 grid grid-cols-2 gap-3 md:grid-cols-3">
    <div class="card-p col-span-2 md:col-span-1">
        <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Total a receber</p>
        <p class="mt-1 text-2xl font-extrabold">@Exibir.Moeda(resumo.TotalAReceber)</p>
    </div>
    <div class="card-p border-rose-200 bg-rose-50">
        <p class="text-xs font-semibold uppercase tracking-wide text-rose-700">Atrasado</p>
        <p class="mt-1 text-xl font-extrabold text-rose-700">@Exibir.Moeda(resumo.Atrasado)</p>
        <p class="text-xs text-rose-600">@resumo.QtdAtrasadas @(resumo.QtdAtrasadas == 1 ? "parcela" : "parcelas")</p>
    </div>
    <div class="card-p">
        <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Vence esta semana</p>
        <p class="mt-1 text-xl font-extrabold">@Exibir.Moeda(resumo.VenceEstaSemana)</p>
    </div>
</div>

@* Abas: Atrasadas · A vencer · Pagas *@
<div class="-mx-4 mt-5 overflow-x-auto px-4 sm:mx-0 sm:px-0">
    <nav class="segmentado" aria-label="Abas do crediário">
        @foreach (var (chave, nome) in abas)
        {
            <a href="/crediario?aba=@chave" class="@(aba == chave ? "ativo" : "")">@nome</a>
        }
    </nav>
</div>

@if (devedores is not null)
{
    <div class="card mt-4 divide-y divide-slate-100">
        @if (devedores.Count == 0) { <p class="p-8 text-center text-slate-500">Ninguém devendo. 🎉</p> }
        @foreach (var d in devedores)
        {
            <a href="/clientes/@d.ClienteId" class="flex items-center gap-3 p-4 hover:bg-slate-50">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-marca-50 text-sm font-bold text-marca-700">@Exibir.Iniciais(d.Cliente)</span>
                <div class="min-w-0 flex-1">
                    <p class="truncate font-semibold">@d.Cliente</p>
                    <p class="text-xs text-slate-500">@d.QtdParcelas @(d.QtdParcelas == 1 ? "parcela" : "parcelas") · próxima @Exibir.Data(d.ProximoVencimento)</p>
                </div>
                <div class="text-right">
                    <p class="font-extrabold">@Exibir.Moeda(d.TotalDevido)</p>
                    @if (d.Atrasado > 0) { <p class="text-xs font-semibold text-rose-600">@Exibir.Moeda(d.Atrasado) atrasado</p> }
                </div>
            </a>
        }
    </div>
}
else
{
    <div class="mt-4 space-y-2.5" id="lista-parcelas">
        @if (parcelas!.Count == 0)
        {
            <div class="card p-8 text-center text-slate-500">
                @(aba switch { "atrasadas" => "Nenhuma parcela atrasada. 🎉", "pagas" => "Nenhuma parcela paga ainda.", _ => "Nenhuma parcela a vencer." })
            </div>
        }
        @foreach (var p in parcelas)
        {
            <div class="card p-4" data-parcela="@p.Id">
                <div class="flex items-start justify-between gap-3">
                    <div class="min-w-0">
                        <a href="/clientes/@p.ClienteId" class="block truncate font-semibold hover:text-marca-700">@p.Cliente</a>
                        <p class="text-xs text-slate-500">Parcela @p.Numero/@p.TotalParcelas · <a href="/vendas/@p.VendaId" class="hover:text-marca-700">venda nº @p.VendaId</a></p>
                    </div>
                    <div class="shrink-0 text-right">
                        <p class="text-lg font-extrabold">@Exibir.Moeda(p.Valor)</p>
                        <span class="@Exibir.ClasseSituacao(p.Situacao)" data-situacao>
                            @(p.Situacao == "ATRASADA" ? $"{p.DiasAtraso} {(p.DiasAtraso == 1 ? "dia" : "dias")} de atraso" : Exibir.NomeSituacao(p.Situacao))
                        </span>
                    </div>
                </div>
                <div class="mt-3 flex flex-wrap items-center justify-between gap-2 border-t border-slate-100 pt-3">
                    <p class="flex items-center gap-1.5 text-sm text-slate-600">
                        @Icone.Svg("calendario", "w-4 h-4 text-slate-400")
                        @if (p.Situacao == "PAGA") { <span>Paga em @Exibir.Data(p.DataPagamento!.Value)</span> }
                        else { <span>Vence @Exibir.Data(p.DataVencimento)</span> }
                    </p>
                    @if (p.Situacao != "PAGA")
                    {
                        <div class="flex gap-2" data-acoes>
                            <a href="/crediario/@p.Id/cobrar" target="_blank" rel="noopener" class="btn-whatsapp btn-sm @(string.IsNullOrEmpty(p.Telefone) ? "opacity-60" : "")" title="@(string.IsNullOrEmpty(p.Telefone) ? "Cliente sem telefone: você escolhe o contato no WhatsApp" : "Abrir conversa com a mensagem pronta")">
                                @Icone.Svg("whatsapp", "w-4 h-4") Cobrar no WhatsApp
                            </a>
                            <button type="button" class="btn-primario btn-sm" data-baixa="@p.Id" data-valor="@Exibir.Moeda(p.Valor)" data-cliente="@p.Cliente">@Icone.Svg("check", "w-4 h-4") Dar baixa</button>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}

@section Scripts { <script src="~/js/crediario.js" asp-append-version="true"></script> }
