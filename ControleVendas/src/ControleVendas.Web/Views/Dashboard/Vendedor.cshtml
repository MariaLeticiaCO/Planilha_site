@model PainelVendedorDto
@{ ViewData["Title"] = "Início"; }
<p class="subtitulo">Olá, @(User.Identity?.Name?.Split(' ')[0])!</p>
<h1 class="titulo-pagina">Suas vendas de hoje</h1>

<div class="mt-5 grid grid-cols-2 gap-3">
    <div class="card-p">
        <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Vendas</p>
        <p class="mt-2 text-2xl font-extrabold">@Model.QtdVendas</p>
    </div>
    <div class="rounded-2xl bg-gradient-to-br from-marca-600 to-marca-800 p-4 text-white shadow-lg">
        <p class="text-xs font-semibold uppercase tracking-wide text-marca-100">Total vendido</p>
        <p class="mt-2 text-2xl font-extrabold">@Exibir.Moeda(Model.Total)</p>
    </div>
</div>

<a href="/vendas/nova" class="btn-primario btn-lg mt-5 w-full sm:w-auto">@Icone.Svg("mais") Nova venda</a>

<div class="card mt-5 divide-y divide-slate-100">
    @if (Model.Vendas.Count == 0)
    {
        <p class="p-6 text-center text-slate-500">Nenhuma venda hoje ainda. Bora vender!</p>
    }
    @foreach (var v in Model.Vendas)
    {
        <a href="/vendas/@v.Id" class="flex items-center justify-between gap-3 p-4 hover:bg-slate-50">
            <div>
                <p class="font-semibold">@(v.Cliente ?? "Venda nº " + v.Id)</p>
                <p class="text-xs text-slate-500">@v.DataVenda.ToString("HH:mm") · @v.FormaPagamento</p>
            </div>
            <div class="text-right">
                <p class="font-bold @(v.Status == StatusVenda.CANCELADA ? "text-slate-400 line-through" : "")">@Exibir.Moeda(v.Total)</p>
                @if (v.Status == StatusVenda.CANCELADA) { <span class="chip-cinza">Cancelada</span> }
            </div>
        </a>
    }
</div>
