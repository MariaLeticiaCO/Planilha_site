@model IReadOnlyList<FormaPagamentoDto>
@{
    ViewData["Title"] = "Formas de pagamento";
    var tipos = new (TipoPagamento T, string N)[] { (TipoPagamento.PIX, "Pix"), (TipoPagamento.DINHEIRO, "Dinheiro"), (TipoPagamento.DEBITO, "Débito"), (TipoPagamento.CREDITO, "Crédito"), (TipoPagamento.CREDIARIO, "Crediário") };
    string Num(decimal v) => v.ToString("0.##", Formatos.PtBr);
}
<div class="flex flex-wrap items-end justify-between gap-3">
    <div>
        <h1 class="titulo-pagina">Formas de pagamento</h1>
        <p class="subtitulo">Informe as taxas da sua maquininha. O lucro de cada venda já sai descontado.</p>
    </div>
    <form method="post" asp-antiforgery="true" action="/formas-pagamento/faixas-credito">
        <button class="btn-suave btn-sm">@Icone.Svg("cartao", "w-4 h-4") Criar faixas de crédito parcelado</button>
    </form>
</div>

@* Simulador *@
<div class="mt-4 rounded-2xl bg-gradient-to-br from-marca-600 to-marca-800 p-4 text-white sm:p-5">
    <label for="simular-valor" class="text-sm font-semibold text-marca-100">Simulador: numa venda de</label>
    <div class="mt-1 flex items-center gap-2">
        <span class="text-2xl font-extrabold">R$</span>
        <input id="simular-valor" type="text" inputmode="numeric" data-mascara="dinheiro" value="100,00" class="w-36 rounded-xl border-0 bg-white/15 px-3 py-1.5 text-2xl font-extrabold text-white placeholder:text-white/50 focus:ring-2 focus:ring-white" />
    </div>
    <p class="mt-1 text-sm text-marca-100">você recebe (já descontada a taxa):</p>
</div>

<div class="mt-4 space-y-3">
    @foreach (var f in Model)
    {
        <form method="post" asp-antiforgery="true" action="/formas-pagamento" class="card p-3 sm:p-4 @(f.Ativo ? "" : "opacity-60")" data-forma>
            <input type="hidden" name="Id" value="@f.Id" />
            <input type="hidden" name="Ativo" value="@(f.Ativo ? "true" : "false")" />
            <div class="flex flex-wrap items-center gap-3">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-marca-50 text-marca-700">@Icone.Svg(Exibir.IconeForma(f.Tipo))</span>
                <div class="min-w-[9rem] flex-1">
                    <input name="Nome" value="@f.Nome" class="w-full border-0 bg-transparent p-0 font-semibold focus:ring-0" maxlength="40" aria-label="Nome" />
                    <select name="Tipo" class="mt-0.5 border-0 bg-transparent p-0 pr-7 text-xs text-slate-500 focus:ring-0" aria-label="Tipo">
                        @foreach (var (t, n) in tipos) { <option value="@t" selected="@(f.Tipo == t)">@n</option> }
                    </select>
                </div>
                <div class="text-right">
                    <p class="text-xs text-slate-500">recebe</p>
                    <p class="font-extrabold text-emerald-600" data-recebe>—</p>
                </div>
            </div>
            <div class="mt-3 flex flex-wrap items-end gap-2">
                <label class="w-28">
                    <span class="rotulo text-xs">Taxa %</span>
                    <input name="TaxaPercentual" value="@Num(f.TaxaPercentual)" inputmode="decimal" class="campo py-2" data-taxa-pct />
                </label>
                <label class="w-28">
                    <span class="rotulo text-xs">Taxa fixa R$</span>
                    <input name="TaxaFixa" value="@Num(f.TaxaFixa)" inputmode="decimal" class="campo py-2" data-taxa-fixa />
                </label>
                <button class="btn-primario btn-sm py-2.5">Salvar</button>
                <span class="flex-1"></span>
                <button type="submit" form="alternar-@f.Id" class="btn-sm btn text-slate-500 hover:bg-slate-100">@(f.Ativo ? "Desativar" : "Ativar")</button>
            </div>
        </form>
        <form method="post" asp-antiforgery="true" action="/formas-pagamento/@f.Id/ativo" id="alternar-@f.Id" class="hidden">
            <input type="hidden" name="ativo" value="@(f.Ativo ? "false" : "true")" />
        </form>
    }
</div>

<details class="card mt-4 p-4">
    <summary class="cursor-pointer font-semibold text-marca-700">+ Nova forma de pagamento</summary>
    <form method="post" asp-antiforgery="true" action="/formas-pagamento" class="mt-3 grid gap-3 sm:grid-cols-4 sm:items-end">
        <input type="hidden" name="Ativo" value="true" />
        <label class="sm:col-span-2"><span class="rotulo">Nome</span><input name="Nome" class="campo" placeholder="Ex.: Crédito 2–6x" maxlength="40" required /></label>
        <label><span class="rotulo">Tipo</span>
            <select name="Tipo" class="campo">@foreach (var (t, n) in tipos) { <option value="@t">@n</option> }</select>
        </label>
        <label><span class="rotulo">Taxa %</span><input name="TaxaPercentual" value="0" inputmode="decimal" class="campo" /></label>
        <label><span class="rotulo">Taxa fixa R$</span><input name="TaxaFixa" value="0" inputmode="decimal" class="campo" /></label>
        <button class="btn-primario sm:col-span-3">Adicionar</button>
    </form>
</details>

@section Scripts {
<script>
$(function () {
  function simular() {
    const valor = App.lerNumero($('#simular-valor').val());
    $('[data-forma]').each(function () {
      const pct = App.lerNumero($(this).find('[data-taxa-pct]').val());
      const fixa = App.lerNumero($(this).find('[data-taxa-fixa]').val());
      const taxa = valor > 0 ? Math.round((valor * pct / 100 + fixa) * 100) / 100 : 0;
      $(this).find('[data-recebe]').text(App.moeda(valor - taxa));
    });
  }
  $(document).on('input', '#simular-valor, [data-taxa-pct], [data-taxa-fixa]', simular);
  simular();
});
</script>
}
