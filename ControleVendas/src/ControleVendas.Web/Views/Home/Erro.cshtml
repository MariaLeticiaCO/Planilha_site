@{
    Layout = "_LayoutAuth";
    int codigo = ViewBag.Codigo;
    ViewData["Title"] = codigo == 404 ? "Página não encontrada" : "Algo deu errado";
}
<div class="text-center">
    <p class="text-5xl font-extrabold text-marca-600">@codigo</p>
    <h1 class="mt-2 text-xl font-bold">@ViewData["Title"]</h1>
    <p class="mt-2 text-slate-600">
        @(codigo == 404 ? "O endereço que você abriu não existe ou foi movido." : "Já registramos o problema. Tente de novo em instantes.")
    </p>
    <a href="/" class="btn-primario mt-5 w-full">Voltar ao início</a>
</div>
