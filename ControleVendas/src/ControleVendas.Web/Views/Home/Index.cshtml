@model IReadOnlyList<PlanoInfo>
@{
    Layout = "_LayoutPublico";
    ViewData["Title"] = "Saiba quanto você lucra de verdade";
    var perguntas = new (string P, string R)[]
    {
        ("Preciso instalar alguma coisa?", "Não. Funciona no navegador do celular e do computador. Se quiser, toque em “Adicionar à tela inicial” e ele vira um app no seu celular."),
        ("Como vocês calculam o lucro?", "Em cada venda: valor vendido, menos o desconto, menos a taxa da maquininha ou do Pix, menos o custo dos produtos. Você vê o lucro líquido de verdade, não só o faturamento."),
        ("Serve para quem vende no Instagram, WhatsApp e feira?", "Foi feito para isso. Registrar uma venda leva menos de 15 segundos no celular, e o crediário (fiado) fica organizado com cobrança pronta no WhatsApp."),
        ("O teste grátis pede cartão?", "Não. São 7 dias com tudo do plano Pro liberado. Depois você escolhe se quer continuar."),
        ("E se o teste acabar?", "Seus dados continuam lá. Você ainda entra e vê o painel; só não registra vendas novas até assinar."),
        ("Meus dados ficam seguros?", "Sim. Senhas criptografadas, conexão segura (HTTPS), backup diário e cada negócio só enxerga os próprios dados. Você pode excluir sua conta quando quiser.")
    };
}

@* Hero *@
<section class="relative overflow-hidden bg-gradient-to-b from-marca-50 to-slate-50">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 pb-12 pt-10 sm:px-6 lg:grid-cols-2 lg:pb-20 lg:pt-16">
        <div>
            <span class="chip-marca mb-4">@Icone.Svg("brilho", "w-3.5 h-3.5") Para quem vende no Insta, no Zap e na feira</span>
            <h1 class="text-4xl font-extrabold leading-tight tracking-tight text-slate-900 sm:text-5xl">
                Saiba quanto você <span class="text-marca-600">lucra de verdade</span>
            </h1>
            <p class="mt-4 max-w-xl text-lg text-slate-600">
                Registre a venda em segundos pelo celular e veja o lucro do dia, da semana, do mês e do ano —
                já descontando o custo do produto e a taxa da maquininha.
            </p>
            <div class="mt-7 flex flex-col gap-3 sm:flex-row">
                <a href="/cadastro" class="btn-primario btn-lg">Testar grátis 7 dias</a>
                <a href="#planos" class="btn-secundario btn-lg">Ver planos</a>
            </div>
            <p class="mt-3 text-sm text-slate-500">Sem cartão de crédito · Configuração em 2 minutos</p>
        </div>
        <div class="relative">
            <img src="/img/print-painel.png" alt="Print do painel mostrando faturamento, lucro líquido, gráfico de vendas e produtos mais vendidos"
                 class="w-full rounded-2xl border border-slate-200 shadow-2xl shadow-marca-900/10" width="1200" height="800" loading="eager" />
            <img src="/img/print-celular.png" alt="Tela de nova venda no celular"
                 class="absolute -bottom-8 -left-4 hidden w-36 rounded-[1.75rem] border-4 border-slate-900 shadow-2xl sm:block lg:-left-10 lg:w-44" width="390" height="844" loading="lazy" />
        </div>
    </div>
</section>

@* 3 benefícios *@
<section class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <div class="grid gap-5 md:grid-cols-3">
        @foreach (var (icone, titulo, texto) in new[]
        {
            ("tendencia", "Lucro líquido em tempo real", "Cada venda já desconta custo e taxa. Veja hoje, semana, mês ou ano, com gráfico e ranking dos produtos que mais (e menos) vendem."),
            ("relogio", "Venda registrada em 15 segundos", "Busque o produto, toque no +, escolha Pix, dinheiro, cartão ou crediário. Pronto — e ainda manda o recibo no WhatsApp."),
            ("whatsapp", "Crediário sem caderninho", "Parcelas geradas sozinhas, lista de quem está atrasado e botão de cobrar com a mensagem pronta no WhatsApp.")
        })
        {
            <div class="card-p">
                <span class="mb-3 inline-flex h-11 w-11 items-center justify-center rounded-xl bg-marca-100 text-marca-700">@Icone.Svg(icone, "w-6 h-6")</span>
                <h2 class="text-lg font-bold text-slate-900">@titulo</h2>
                <p class="mt-1.5 text-slate-600">@texto</p>
            </div>
        }
    </div>
</section>

@* Planos e preços *@
<section id="planos" class="border-y border-slate-200 bg-white">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
        <h2 class="text-center text-3xl font-extrabold text-slate-900">Planos e preços</h2>
        <p class="mt-2 text-center text-slate-600">Comece com 7 dias grátis com tudo do Pro.</p>
        <div class="mt-10 grid gap-5 md:grid-cols-3">
            <div class="card-p flex flex-col">
                <h3 class="font-bold text-slate-900">Teste</h3>
                <p class="mt-2"><span class="text-3xl font-extrabold">Grátis</span> <span class="text-slate-500">por 7 dias</span></p>
                <ul class="mt-5 flex-1 space-y-2 text-sm text-slate-600">
                    <li class="flex gap-2"><span class="text-emerald-600">@Icone.Svg("check", "w-4 h-4")</span>Tudo do plano Pro</li>
                    <li class="flex gap-2"><span class="text-emerald-600">@Icone.Svg("check", "w-4 h-4")</span>Sem cartão de crédito</li>
                </ul>
                <a href="/cadastro" class="btn-secundario mt-6">Começar teste</a>
            </div>
            @foreach (var plano in Model.Where(p => p.Opcao != OpcaoPlano.PRO_ANUAL))
            {
                var pro = plano.Opcao == OpcaoPlano.PRO_MENSAL;
                <div class="flex flex-col rounded-2xl p-5 @(pro ? "bg-marca-600 text-white shadow-xl shadow-marca-600/25 ring-1 ring-marca-700" : "card")">
                    <div class="flex items-center justify-between">
                        <h3 class="font-bold">@(pro ? "Pro" : plano.Nome)</h3>
                        @if (pro) { <span class="chip bg-white/20 text-white">Mais escolhido</span> }
                    </div>
                    <p class="mt-2">
                        <span class="text-3xl font-extrabold">@Exibir.Moeda(plano.Preco)</span>
                        <span class="@(pro ? "text-marca-100" : "text-slate-500")">@plano.Periodicidade</span>
                    </p>
                    @if (pro) { <p class="text-sm text-marca-100">ou @Exibir.Moeda(Planos.ProAnual.Preco) por ano</p> }
                    <ul class="mt-5 flex-1 space-y-2 text-sm @(pro ? "text-marca-50" : "text-slate-600")">
                        @foreach (var item in plano.Inclui)
                        {
                            <li class="flex gap-2"><span class="@(pro ? "text-white" : "text-emerald-600")">@Icone.Svg("check", "w-4 h-4")</span>@item</li>
                        }
                    </ul>
                    <a href="/cadastro" class="btn mt-6 @(pro ? "bg-white text-marca-700 hover:bg-marca-50" : "btn-secundario")">Testar grátis 7 dias</a>
                </div>
            }
        </div>
    </div>
</section>

@* Perguntas frequentes *@
<section class="mx-auto max-w-3xl px-4 py-14 sm:px-6">
    <h2 class="text-center text-3xl font-extrabold text-slate-900">Perguntas frequentes</h2>
    <div class="mt-8 space-y-3">
        @foreach (var (p, r) in perguntas)
        {
            <details class="card group p-4 [&_summary::-webkit-details-marker]:hidden">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-3 font-semibold text-slate-900">
                    @p <span class="text-slate-400 transition group-open:rotate-90">@Icone.Svg("direita", "w-4 h-4")</span>
                </summary>
                <p class="mt-2 text-slate-600">@r</p>
            </details>
        }
    </div>
</section>

<section class="mx-auto max-w-6xl px-4 pb-16 sm:px-6">
    <div class="rounded-3xl bg-gradient-to-br from-marca-600 to-marca-800 px-6 py-10 text-center text-white sm:px-12">
        <h2 class="text-2xl font-extrabold sm:text-3xl">Pare de vender no escuro</h2>
        <p class="mx-auto mt-2 max-w-xl text-marca-100">Em 2 minutos você configura e já vê quanto ganhou hoje.</p>
        <a href="/cadastro" class="btn btn-lg mt-6 bg-white text-marca-700 hover:bg-marca-50">Testar grátis 7 dias</a>
    </div>
</section>
