@model OnboardingDto
@{
    Layout = "_LayoutAuth";
    ViewData["Title"] = "Configuração inicial";
    var setores = (IReadOnlyList<SetorDto>)ViewBag.Setores;
}
<div class="mb-5">
    <div class="flex items-center justify-between text-xs font-semibold text-slate-500">
        <span id="passo-rotulo">Passo 1 de 3</span>
        <span>Leva uns 2 minutos</span>
    </div>
    <div class="mt-2 h-1.5 rounded-full bg-slate-100"><div id="passo-barra" class="h-1.5 rounded-full bg-marca-600 transition-all" style="width:33%"></div></div>
</div>

<form asp-antiforgery="true" id="form-onboarding" method="post" action="/comecar" novalidate data-sem-trava>
    <div asp-validation-summary="All"></div>
    <input type="hidden" asp-for="PularProduto" />

    @* Passo 1: negócio e setor *@
    <section data-passo="1">
        <h1 class="text-xl font-extrabold text-slate-900">Como se chama seu negócio?</h1>
        <div class="mt-4">
            <label asp-for="NomeNegocio" class="rotulo">Nome do negócio</label>
            <input asp-for="NomeNegocio" class="campo" placeholder="Ex.: Doces da Ana" autofocus />
            <span asp-validation-for="NomeNegocio" class="erro-campo"></span>
        </div>
        <p class="rotulo mt-5">O que você vende?</p>
        <div class="grid grid-cols-2 gap-2.5 sm:grid-cols-3">
            @foreach (var s in setores)
            {
                <label class="group cursor-pointer">
                    <input type="radio" name="SetorId" value="@s.Id" class="peer sr-only" @(Model.SetorId == s.Id ? "checked" : "") />
                    <span class="flex h-full flex-col items-center gap-1.5 rounded-xl border-2 border-slate-200 p-3 text-center text-sm font-semibold text-slate-700 transition peer-checked:border-marca-600 peer-checked:bg-marca-50 peer-checked:text-marca-800 peer-focus-visible:ring-2 peer-focus-visible:ring-marca-400">
                        <span class="text-marca-600">@Icone.Svg(s.Icone, "w-7 h-7")</span>
                        @s.Nome
                    </span>
                </label>
            }
        </div>
        <p id="erro-setor" class="erro-campo oculto">Escolha o setor do seu negócio.</p>
        <p class="dica mt-3">Vamos criar categorias sugeridas para o seu setor. Dá para mudar depois.</p>
        <button type="button" class="btn-primario btn-lg mt-6 w-full" data-ir="2">Continuar</button>
    </section>

    @* Passo 2: formas de pagamento e taxas *@
    <section data-passo="2" class="oculto">
        <h1 class="text-xl font-extrabold text-slate-900">Como você recebe?</h1>
        <p class="mt-1 text-sm text-slate-500">Deixe marcadas as formas que você usa e informe a taxa de cada uma.</p>
        <div class="mt-4 divide-y divide-slate-100 rounded-xl border border-slate-200">
            @for (var i = 0; i < Model.Formas.Count; i++)
            {
                var f = Model.Formas[i];
                <div class="flex items-center gap-3 p-3">
                    <input type="hidden" name="Formas[@i].Tipo" value="@f.Tipo" />
                    <input type="hidden" name="Formas[@i].Nome" value="@f.Nome" />
                    <label class="flex flex-1 items-center gap-3 text-sm font-semibold text-slate-800">
                        <input type="checkbox" name="Formas[@i].Ativo" value="true" @(f.Ativo ? "checked" : "") class="h-5 w-5 rounded border-slate-300 text-marca-600 focus:ring-marca-500" />
                        <input type="hidden" name="Formas[@i].Ativo" value="false" />
                        <span class="text-slate-500">@Icone.Svg(Exibir.IconeForma(f.Tipo))</span>
                        @f.Nome
                    </label>
                    @if (f.Tipo is TipoPagamento.DEBITO or TipoPagamento.CREDITO or TipoPagamento.PIX)
                    {
                        <div class="relative w-24">
                            <input type="text" inputmode="decimal" name="Formas[@i].TaxaPercentual" value="@f.TaxaPercentual.ToString("0.##", Formatos.PtBr)" class="campo pr-7 text-right" aria-label="Taxa do @f.Nome em %" />
                            <span class="pointer-events-none absolute inset-y-0 right-3 flex items-center text-sm text-slate-400">%</span>
                        </div>
                    }
                    else
                    {
                        <input type="hidden" name="Formas[@i].TaxaPercentual" value="0" />
                        <span class="w-24 text-right text-xs text-slate-400">sem taxa</span>
                    }
                </div>
            }
        </div>
        <p class="mt-3 flex items-start gap-2 rounded-xl bg-amber-50 p-3 text-xs text-amber-800">@Icone.Svg("info", "w-4 h-4 shrink-0") Veja a taxa no app da sua maquininha. Se não souber agora, deixe 0 e ajuste depois em Formas de pagamento.</p>
        <div class="mt-6 flex gap-3">
            <button type="button" class="btn-secundario btn-lg" data-ir="1">Voltar</button>
            <button type="button" class="btn-primario btn-lg flex-1" data-ir="3">Continuar</button>
        </div>
    </section>

    @* Passo 3: primeiro produto *@
    <section data-passo="3" class="oculto">
        <h1 class="text-xl font-extrabold text-slate-900">Cadastre seu primeiro produto</h1>
        <p class="mt-1 text-sm text-slate-500">Assim você já registra uma venda e vê o lucro.</p>
        <div class="mt-4 space-y-4">
            <div>
                <label asp-for="ProdutoNome" class="rotulo">Nome do produto</label>
                <input asp-for="ProdutoNome" class="campo" placeholder="Ex.: Brigadeiro gourmet" />
            </div>
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label asp-for="ProdutoCusto" class="rotulo">Custo (R$)</label>
                    <input asp-for="ProdutoCusto" type="text" class="campo" inputmode="numeric" data-mascara="dinheiro" placeholder="0,00" />
                </div>
                <div>
                    <label asp-for="ProdutoPreco" class="rotulo">Preço de venda (R$)</label>
                    <input asp-for="ProdutoPreco" type="text" class="campo" inputmode="numeric" data-mascara="dinheiro" placeholder="0,00" />
                </div>
            </div>
            <div class="flex items-center justify-between rounded-xl bg-slate-50 p-3 text-sm">
                <span class="text-slate-600">Margem</span>
                <span id="onb-margem" class="chip-cinza">—</span>
            </div>
        </div>
        <div class="mt-6 flex flex-col gap-3">
            <button type="submit" class="btn-primario btn-lg w-full">Concluir e ir para o painel</button>
            <div class="flex gap-3">
                <button type="button" class="btn-secundario flex-1" data-ir="2">Voltar</button>
                <button type="button" id="btn-pular" class="btn-secundario flex-1">Pular</button>
            </div>
        </div>
    </section>
</form>

@section Scripts {
<script>
$(function () {
  const $form = $('#form-onboarding');
  function irPara(n) {
    $('[data-passo]').addClass('oculto');
    $(`[data-passo="${n}"]`).removeClass('oculto').find('input:visible').first().trigger('focus');
    $('#passo-rotulo').text(`Passo ${n} de 3`);
    $('#passo-barra').css('width', `${n * 33.34}%`);
    window.scrollTo(0, 0);
  }
  $('[data-ir]').on('click', function () {
    const destino = Number($(this).data('ir'));
    const atual = Number($(this).closest('[data-passo]').data('passo'));
    if (destino > atual && atual === 1) {
      const nomeOk = $('#NomeNegocio').val().trim().length > 0;
      const setorOk = $('input[name="SetorId"]:checked').length > 0;
      $('#NomeNegocio').toggleClass('input-validation-error', !nomeOk);
      $('#erro-setor').toggleClass('oculto', setorOk);
      if (!nomeOk || !setorOk) return;
    }
    if (destino > atual && atual === 2 && $('input[name$=".Ativo"]:checked').length === 0) {
      App.toast('Deixe pelo menos uma forma de pagamento marcada.', 'erro');
      return;
    }
    irPara(destino);
  });
  $('#btn-pular').on('click', function () { $('#PularProduto').val('true'); $form.trigger('submit'); });

  function margem() {
    const custo = App.lerNumero($('#ProdutoCusto').val());
    const preco = App.lerNumero($('#ProdutoPreco').val());
    const $m = $('#onb-margem');
    if (!preco) { $m.attr('class', 'chip-cinza').text('—'); return; }
    const m = (preco - custo) / preco * 100;
    $m.attr('class', m > 30 ? 'chip-verde' : m >= 15 ? 'chip-amarelo' : 'chip-vermelho')
      .text(`${App.numero(m, 1)}% · lucro ${App.moeda(preco - custo)} por unidade`);
  }
  $('#ProdutoCusto, #ProdutoPreco').on('input', margem);

  // Volta para o passo com erro quando o servidor rejeita
  if ($('.validation-summary-errors').length) irPara(1);
});
</script>
}
