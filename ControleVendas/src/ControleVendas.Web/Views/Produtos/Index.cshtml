@model IReadOnlyList<ProdutoListaDto>
@{
    ViewData["Title"] = "Produtos";
    var filtro = (FiltroProdutosDto)ViewBag.Filtro;
    var categorias = (IReadOnlyList<CategoriaDto>)ViewBag.Categorias;
}
<div class="flex items-center justify-between gap-3">
    <div>
        <h1 class="titulo-pagina">Produtos</h1>
        <p class="subtitulo">@Model.Count @(Model.Count == 1 ? "produto" : "produtos")</p>
    </div>
    <a href="/produtos/novo" class="btn-primario">@Icone.Svg("mais") Produto</a>
</div>

<form method="get" class="mt-4 flex flex-col gap-2 sm:flex-row" data-sem-trava>
    <label class="relative flex-1">
        <span class="pointer-events-none absolute inset-y-0 left-3.5 flex items-center text-slate-400">@Icone.Svg("busca")</span>
        <input type="search" name="busca" value="@filtro.Busca" class="campo pl-11" placeholder="Buscar por nome ou código" />
    </label>
    <div class="flex gap-2">
        <select name="categoriaId" class="campo sm:w-44" data-autoenviar aria-label="Categoria">
            <option value="">Todas as categorias</option>
            @foreach (var c in categorias) { <option value="@c.Id" selected="@(filtro.CategoriaId == c.Id)">@c.Nome</option> }
        </select>
        <select name="status" class="campo sm:w-40" data-autoenviar aria-label="Status">
            <option value="ativos" selected="@(filtro.Status == "ativos")">Ativos</option>
            <option value="estoque-baixo" selected="@(filtro.Status == "estoque-baixo")">Estoque baixo</option>
            <option value="inativos" selected="@(filtro.Status == "inativos")">Inativos</option>
            <option value="todos" selected="@(filtro.Status == "todos")">Todos</option>
        </select>
    </div>
</form>

@if (Model.Count == 0)
{
    <div class="card mt-4 p-10 text-center">
        <p class="text-slate-500">Nenhum produto por aqui.</p>
        <a href="/produtos/novo" class="btn-primario mt-4">Cadastrar produto</a>
    </div>
}
<div class="mt-4 grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
    @foreach (var p in Model)
    {
        <div class="card flex gap-3 p-3 @(p.Ativo ? "" : "opacity-60")">
            <a href="/produtos/@p.Id/editar" class="shrink-0">
                @if (!string.IsNullOrEmpty(p.FotoUrl))
                {
                    <img src="@p.FotoUrl" alt="" class="h-20 w-20 rounded-xl object-cover" loading="lazy" />
                }
                else
                {
                    <span class="flex h-20 w-20 items-center justify-center rounded-xl bg-marca-50 text-marca-300">@Icone.Svg("imagem", "w-8 h-8")</span>
                }
            </a>
            <div class="min-w-0 flex-1">
                <a href="/produtos/@p.Id/editar" class="block truncate font-semibold text-slate-900 hover:text-marca-700">@p.Nome</a>
                <p class="text-xs text-slate-500">@(p.Categoria ?? "Sem categoria")@(p.Codigo is not null ? " · " + p.Codigo : "")</p>
                <div class="mt-1.5 flex flex-wrap items-center gap-1.5">
                    <span class="text-base font-bold">@Exibir.Moeda(p.PrecoVenda)</span>
                    <span class="@Exibir.ClasseMargem(p.MargemPercentual)" title="Margem">@Exibir.Percentual(p.MargemPercentual)</span>
                </div>
                <div class="mt-1 flex items-center justify-between">
                    <span class="text-xs @(p.EstoqueBaixo ? "font-semibold text-rose-600" : "text-slate-500")">
                        @(p.EstoqueBaixo ? "⚠ " : "")Estoque: @p.Estoque
                    </span>
                    <span class="flex gap-1">
                        <a href="/produtos/@p.Id/editar" class="rounded-lg p-1.5 text-slate-400 hover:bg-slate-100 hover:text-slate-700" title="Editar">@Icone.Svg("lapis", "w-4 h-4")</a>
                        <form method="post" asp-antiforgery="true" action="/produtos/@p.Id/ativo">
                            <input type="hidden" name="ativo" value="@(!p.Ativo ? "true" : "false")" />
                            <button class="rounded-lg px-2 py-1 text-xs font-semibold text-slate-500 hover:bg-slate-100">@(p.Ativo ? "Desativar" : "Reativar")</button>
                        </form>
                    </span>
                </div>
            </div>
        </div>
    }
</div>
