@using ControleVendas.Infra.Exports
@model RelatorioDto
@{
    ViewData["Title"] = "Relatórios";
    var tipos = (IReadOnlyList<TipoRelatorio>)ViewBag.Tipos;
    DateTime inicio = ViewBag.Inicio;
    DateTime fim = ViewBag.Fim;
    var empresa = (EmpresaContextoDto)Context.Items[ControleVendas.Web.Filters.EmpresaFilter.ChaveItems]!;
    string Exportar(string formato) => $"/relatorios/exportar?tipo={Model.Tipo}&formato={formato}&inicio={inicio:yyyy-MM-dd}&fim={fim:yyyy-MM-dd}";
    bool Direita(TipoColuna t) => t != TipoColuna.Texto;
}
<div class="flex flex-wrap items-end justify-between gap-3">
    <div>
        <h1 class="titulo-pagina">Relatórios</h1>
        <p class="subtitulo">@tipos.First(t => t.Chave == Model.Tipo).Descricao</p>
    </div>
    <div class="flex gap-2">
        @if (empresa.TemRecursosPro)
        {
            <a href="@Exportar("pdf")" class="btn-secundario btn-sm">@Icone.Svg("download", "w-4 h-4") PDF</a>
            <a href="@Exportar("excel")" class="btn-secundario btn-sm">@Icone.Svg("download", "w-4 h-4") Excel</a>
        }
        else
        {
            <a href="/assinatura" class="btn-suave btn-sm" title="Exportar é do plano Pro">@Icone.Svg("cadeado", "w-4 h-4") Exportar (Pro)</a>
        }
    </div>
</div>

<form method="get" class="card-p mt-4 grid grid-cols-2 gap-3 md:grid-cols-4 md:items-end" data-sem-trava>
    <div class="col-span-2">
        <label for="tipo" class="rotulo">Relatório</label>
        <select id="tipo" name="tipo" class="campo" data-autoenviar>
            @foreach (var t in tipos) { <option value="@t.Chave" selected="@(t.Chave == Model.Tipo)">@t.Nome</option> }
        </select>
    </div>
    @if (Model.Tipo != "crediario-cliente")
    {
        <div><label for="inicio" class="rotulo">De</label><input type="date" id="inicio" name="inicio" value="@inicio.ToString("yyyy-MM-dd")" class="campo" /></div>
        <div><label for="fim" class="rotulo">Até</label><input type="date" id="fim" name="fim" value="@fim.ToString("yyyy-MM-dd")" class="campo" /></div>
        <button class="btn-suave col-span-2 md:col-span-4 md:justify-self-end">Atualizar</button>
    }
</form>

<div class="card mt-4 overflow-hidden">
    <div class="border-b border-slate-100 px-4 py-3">
        <h2 class="font-bold">@Model.Titulo</h2>
        <p class="text-xs text-slate-500">@Model.Subtitulo</p>
    </div>
    @if (Model.Linhas.Count == 0)
    {
        <p class="p-8 text-center text-slate-500">Nada para mostrar nesse período.</p>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="tabela whitespace-nowrap">
                <thead><tr>@foreach (var c in Model.Colunas) { <th class="@(Direita(c.Tipo) ? "text-right" : "")">@c.Titulo</th> }</tr></thead>
                <tbody>
                    @foreach (var linha in Model.Linhas)
                    {
                        <tr>
                            @for (var i = 0; i < Model.Colunas.Count; i++)
                            {
                                var col = Model.Colunas[i];
                                var valor = linha.ElementAtOrDefault(i);
                                var classe = Direita(col.Tipo) ? "text-right" : "";
                                if (Model.Tipo == "curva-abc" && i == 0)
                                {
                                    <td><span class="@(valor as string == "A" ? "chip-verde" : valor as string == "B" ? "chip-amarelo" : "chip-cinza")">@valor</span></td>
                                }
                                else
                                {
                                    <td class="@classe @(col.Tipo == TipoColuna.Moeda && valor is decimal d && d < 0 ? "text-rose-600" : "")">@ExportadorRelatorios.FormatarValor(col.Tipo, valor)</td>
                                }
                            }
                        </tr>
                    }
                </tbody>
                @if (Model.Totais is not null)
                {
                    <tfoot>
                        <tr class="bg-slate-50 font-bold">
                            @for (var i = 0; i < Model.Colunas.Count; i++)
                            {
                                <td class="px-3 py-2.5 @(Direita(Model.Colunas[i].Tipo) ? "text-right" : "")">@ExportadorRelatorios.FormatarValor(Model.Colunas[i].Tipo, Model.Totais.ElementAtOrDefault(i))</td>
                            }
                        </tr>
                    </tfoot>
                }
            </table>
        </div>
    }
</div>
