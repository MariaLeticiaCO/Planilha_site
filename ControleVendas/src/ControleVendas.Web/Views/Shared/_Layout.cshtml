@using ControleVendas.Web.Filters
@{
    var empresa = Context.Items[EmpresaFilter.ChaveItems] as EmpresaContextoDto;
    var dono = User.IsInRole("DONO");
    var nome = User.Identity?.Name ?? "";
    string Ativo(string prefixo) => Context.Request.Path.StartsWithSegments(prefixo) ? "ativo" : "";
    string AtivoExato(string caminho) => Context.Request.Path.Value?.TrimEnd('/') == caminho ? "ativo" : "";
    var esconderNav = ViewData["SemNavInferior"] is true;
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <partial name="_Head" />
    <title>@(ViewData["Title"] is string t ? t + " · " : "")Controle de Vendas</title>
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="min-h-screen">
    <partial name="_Toasts" />

    @* ===== Menu lateral (computador) ===== *@
    <aside class="fixed inset-y-0 left-0 z-40 hidden w-64 flex-col border-r border-slate-200 bg-white lg:flex">
        <div class="px-5 pb-4 pt-5"><a href="/painel"><partial name="_Logo" /></a></div>
        <div class="px-3">
            <a href="/vendas/nova" class="btn-primario w-full">@Icone.Svg("mais") Nova venda</a>
        </div>
        <nav class="nav-lateral mt-4 flex-1 space-y-1 overflow-y-auto px-3">
            <a href="/painel" class="@Ativo("/painel")">@Icone.Svg("casa") Início</a>
            <a href="/vendas/historico" class="@Ativo("/vendas/historico")">@Icone.Svg("recibo") Vendas</a>
            @if (dono)
            {
                <a href="/produtos" class="@Ativo("/produtos")">@Icone.Svg("caixa") Produtos</a>
                <a href="/categorias" class="@Ativo("/categorias")">@Icone.Svg("etiqueta") Categorias</a>
            }
            <a href="/clientes" class="@Ativo("/clientes")">@Icone.Svg("usuarios") Clientes</a>
            <a href="/crediario" class="@Ativo("/crediario")">@Icone.Svg("crediario") Crediário</a>
            @if (dono)
            {
                <a href="/formas-pagamento" class="@Ativo("/formas-pagamento")">@Icone.Svg("cartao") Formas de pagamento</a>
                <a href="/relatorios" class="@Ativo("/relatorios")">@Icone.Svg("grafico") Relatórios</a>
                <p class="px-3 pb-1 pt-4 text-[11px] font-semibold uppercase tracking-wider text-slate-400">Conta</p>
                <a href="/assinatura" class="@Ativo("/assinatura")">@Icone.Svg("coroa") Assinatura</a>
            }
            <a href="/configuracoes" class="@Ativo("/configuracoes")">@Icone.Svg("engrenagem") Configurações</a>
        </nav>
        <div class="border-t border-slate-200 p-3">
            <div class="flex items-center gap-3 rounded-xl px-2 py-2">
                <span class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-marca-100 text-sm font-bold text-marca-700">@Exibir.Iniciais(nome)</span>
                <div class="min-w-0 flex-1">
                    <p class="truncate text-sm font-semibold text-slate-800">@nome</p>
                    <p class="truncate text-xs text-slate-500">@(empresa?.Nome) · @(dono ? "Dono" : "Vendedor")</p>
                </div>
                <form method="post" asp-antiforgery="true" action="/logout">
                    <button class="rounded-lg p-2 text-slate-400 hover:bg-slate-100 hover:text-slate-700" title="Sair" aria-label="Sair">@Icone.Svg("sair", "w-4 h-4")</button>
                </form>
            </div>
        </div>
    </aside>

    <div class="lg:pl-64">
        @* ===== Topo (celular) ===== *@
        <header class="sticky top-0 z-30 border-b border-slate-200/70 bg-white/90 backdrop-blur lg:hidden">
            <div class="flex items-center justify-between px-4 py-2.5">
                <a href="/painel"><partial name="_Logo" view-data='new ViewDataDictionary(ViewData) { ["LogoTamanho"] = "w-8 h-8" }' /></a>
                <a href="/configuracoes" class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-marca-100 text-sm font-bold text-marca-700" aria-label="Minha conta">@Exibir.Iniciais(nome)</a>
            </div>
        </header>

        @if (empresa is not null && !empresa.AssinaturaAtiva)
        {
            <div class="bg-rose-600 text-white">
                <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-2 px-4 py-2.5 text-sm sm:px-6 lg:px-8">
                    <span class="flex items-center gap-2">@Icone.Svg("cadeado", "w-4 h-4") @(empresa.Plano == Plano.TESTE ? "Seu teste grátis acabou." : "Sua assinatura venceu.") Você vê o painel, mas não registra vendas novas.</span>
                    @if (dono) { <a href="/assinatura" class="rounded-lg bg-white px-3 py-1 text-xs font-bold text-rose-700">Renovar agora</a> }
                </div>
            </div>
        }
        else if (empresa is { Plano: Plano.TESTE } && dono)
        {
            <div class="border-b border-marca-100 bg-marca-50">
                <div class="mx-auto flex max-w-6xl items-center justify-between gap-2 px-4 py-2 text-xs sm:px-6 sm:text-sm lg:px-8">
                    <span class="text-marca-800">Teste grátis: <b>@empresa.DiasRestantesTrial @(empresa.DiasRestantesTrial == 1 ? "dia restante" : "dias restantes")</b></span>
                    <a href="/assinatura" class="font-semibold text-marca-700 underline-offset-2 hover:underline">Ver planos</a>
                </div>
            </div>
        }

        <main class="mx-auto max-w-6xl px-4 py-5 sm:px-6 lg:px-8 lg:py-8 @(esconderNav ? "" : "mb-nav")">
            @RenderBody()
        </main>
    </div>

    @* ===== Barra inferior (celular): Início, Vender, Produtos, Crediário, Menu ===== *@
    @if (!esconderNav)
    {
        <nav class="nav-inferior pb-seguro fixed inset-x-0 bottom-0 z-40 flex border-t border-slate-200 bg-white/95 backdrop-blur lg:hidden" aria-label="Navegação principal">
            <a href="/painel" class="@Ativo("/painel")">@Icone.Svg("casa", "w-6 h-6")<span>Início</span></a>
            <a href="/vendas/nova" class="@AtivoExato("/vendas/nova")">
                <span class="-mt-5 mb-0.5 inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-marca-600 text-white shadow-lg shadow-marca-600/40">@Icone.Svg("carrinho", "w-6 h-6")</span>
                <span>Vender</span>
            </a>
            @if (dono)
            {
                <a href="/produtos" class="@Ativo("/produtos")">@Icone.Svg("caixa", "w-6 h-6")<span>Produtos</span></a>
            }
            else
            {
                <a href="/vendas/historico" class="@Ativo("/vendas/historico")">@Icone.Svg("recibo", "w-6 h-6")<span>Vendas</span></a>
            }
            <a href="/crediario" class="@Ativo("/crediario")">@Icone.Svg("crediario", "w-6 h-6")<span>Crediário</span></a>
            <a href="#" data-abrir="menu-mobile">@Icone.Svg("menu", "w-6 h-6")<span>Menu</span></a>
        </nav>

        <div id="menu-mobile" class="oculto fixed inset-0 z-50 lg:hidden" role="dialog" aria-modal="true" aria-label="Menu">
            <div class="absolute inset-0 bg-slate-900/40" data-fechar="menu-mobile"></div>
            <div class="pb-seguro absolute inset-x-0 bottom-0 max-h-[85vh] overflow-y-auto rounded-t-3xl bg-white p-4">
                <div class="mx-auto mb-3 h-1.5 w-10 rounded-full bg-slate-200"></div>
                <div class="mb-3 flex items-center gap-3 px-1">
                    <span class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-marca-100 font-bold text-marca-700">@Exibir.Iniciais(nome)</span>
                    <div><p class="font-semibold">@nome</p><p class="text-xs text-slate-500">@(empresa?.Nome) · @(dono ? "Dono" : "Vendedor")</p></div>
                </div>
                <nav class="nav-lateral grid grid-cols-1 gap-1">
                    <a href="/vendas/historico">@Icone.Svg("recibo") Histórico de vendas</a>
                    <a href="/clientes">@Icone.Svg("usuarios") Clientes</a>
                    @if (dono)
                    {
                        <a href="/categorias">@Icone.Svg("etiqueta") Categorias</a>
                        <a href="/formas-pagamento">@Icone.Svg("cartao") Formas de pagamento</a>
                        <a href="/relatorios">@Icone.Svg("grafico") Relatórios</a>
                        <a href="/assinatura">@Icone.Svg("coroa") Assinatura</a>
                    }
                    <a href="/configuracoes">@Icone.Svg("engrenagem") Configurações</a>
                    <form method="post" asp-antiforgery="true" action="/logout">
                        <button class="flex w-full items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium text-rose-600 hover:bg-rose-50">@Icone.Svg("sair") Sair</button>
                    </form>
                </nav>
            </div>
        </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/mascaras.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
