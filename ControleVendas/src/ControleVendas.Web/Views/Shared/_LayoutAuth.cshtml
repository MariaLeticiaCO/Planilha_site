<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <partial name="_Head" />
    <title>@(ViewData["Title"] is string t ? t + " · " : "")Controle de Vendas</title>
</head>
<body class="min-h-screen bg-gradient-to-b from-marca-50 via-slate-50 to-slate-50">
    <partial name="_Toasts" />
    <div class="mx-auto flex min-h-screen w-full max-w-md flex-col px-4 py-8 sm:py-14">
        <a href="/" class="mx-auto mb-8" aria-label="Início"><partial name="_Logo" /></a>
        <div class="card p-5 sm:p-7">
            @RenderBody()
        </div>
        <p class="mt-6 text-center text-xs text-slate-500">
            <a href="/termos" class="hover:text-marca-700">Termos de uso</a> ·
            <a href="/privacidade" class="hover:text-marca-700">Política de privacidade</a>
        </p>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/mascaras.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
