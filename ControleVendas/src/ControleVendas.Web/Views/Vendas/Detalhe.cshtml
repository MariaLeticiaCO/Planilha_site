@model VendaDetalheDto
@{
    ViewData["Title"] = $"Venda nº {Model.Id}";
    var dono = User.IsInRole("DONO");
    var cancelada = Model.Status == StatusVenda.CANCELADA;
}
<div class="flex items-center gap-3">
    <a href="/vendas/historico" class="rounded-xl p-2 text-slate-500 hover:bg-slate-100" aria-label="Voltar">@Icone.Svg("esquerda")</a>
    <div class="flex-1">
        <h1 class="titulo-pagina">Venda nº @Model.Id</h1>
        <p class="subtitulo">@Exibir.DataHora(Model.DataVenda) · por @Model.Vendedor</p>
    </div>
    @if (cancelada) { <span class="chip-cinza">Cancelada</span> } else { <span class="chip-verde">Concluída</span> }
</div>

@if (cancelada)
{
    <div class="mt-4 rounded-2xl bg-slate-100 p-4 text-sm text-slate-600">Cancelada em @Exibir.DataHora(Model.DataCancelamento!.Value). O estoque foi devolvido e as parcelas em aberto foram canceladas.</div>
}

<div class="mt-4 grid gap-4 lg:grid-cols-3">
    <div class="space-y-4 lg:col-span-2">
        <div class="card overflow-hidden">
            <h2 class="border-b border-slate-100 px-4 py-3 font-bold">Itens</h2>
            <ul class="divide-y divide-slate-100">
                @foreach (var i in Model.Itens)
                {
                    <li class="flex items-center justify-between gap-3 px-4 py-3 text-sm">
                        <div>
                            <p class="font-semibold">@i.Quantidade× @i.Produto</p>
                            <p class="text-xs text-slate-500">@Exibir.Moeda(i.PrecoUnitario) cada@(i.CustoUnitario is not null ? $" · custo {Exibir.Moeda(i.CustoUnitario)}" : "")</p>
                        </div>
                        <span class="font-semibold">@Exibir.Moeda(i.Subtotal)</span>
                    </li>
                }
            </ul>
        </div>

        @if (Model.Parcelas.Count > 0)
        {
            <div class="card overflow-hidden">
                <h2 class="border-b border-slate-100 px-4 py-3 font-bold">Parcelas do crediário</h2>
                <ul class="divide-y divide-slate-100">
                    @foreach (var p in Model.Parcelas)
                    {
                        <li class="flex items-center justify-between gap-3 px-4 py-3 text-sm">
                            <div>
                                <p class="font-semibold">@p.Numero/@p.TotalParcelas · @Exibir.Moeda(p.Valor)</p>
                                <p class="text-xs text-slate-500">Vence @Exibir.Data(p.DataVencimento)@(p.DataPagamento is not null ? $" · paga em {Exibir.Data(p.DataPagamento.Value)}" : "")</p>
                            </div>
                            <span class="@Exibir.ClasseSituacao(p.Situacao)">@Exibir.NomeSituacao(p.Situacao)</span>
                        </li>
                    }
                </ul>
            </div>
        }
    </div>

    <div class="space-y-4">
        <div class="card-p">
            <dl class="space-y-2 text-sm">
                @if (Model.Cliente is not null)
                {
                    <div class="flex justify-between gap-2"><dt class="text-slate-500">Cliente</dt><dd class="text-right font-semibold"><a href="/clientes/@Model.ClienteId" class="text-marca-700">@Model.Cliente</a></dd></div>
                }
                <div class="flex justify-between"><dt class="text-slate-500">Pagamento</dt><dd class="font-semibold">@Model.FormaPagamento</dd></div>
                <div class="flex justify-between"><dt class="text-slate-500">Subtotal</dt><dd>@Exibir.Moeda(Model.ValorBruto)</dd></div>
                <div class="flex justify-between"><dt class="text-slate-500">Desconto</dt><dd>− @Exibir.Moeda(Model.Desconto)</dd></div>
                <div class="flex justify-between border-t border-slate-100 pt-2"><dt class="font-semibold">Total</dt><dd class="text-lg font-extrabold">@Exibir.Moeda(Model.ValorLiquido)</dd></div>
                <div class="flex justify-between"><dt class="text-slate-500">Taxa</dt><dd>− @Exibir.Moeda(Model.ValorTaxa)</dd></div>
                @if (Model.CustoTotal is not null)
                {
                    <div class="flex justify-between"><dt class="text-slate-500">Custo dos itens</dt><dd>− @Exibir.Moeda(Model.CustoTotal)</dd></div>
                }
                @if (Model.Lucro is not null)
                {
                    <div class="flex justify-between rounded-lg px-3 py-2 font-bold @(Model.Lucro < 0 ? "bg-rose-50 text-rose-700" : "bg-emerald-50 text-emerald-700")"><dt>Lucro</dt><dd>@Exibir.Moeda(Model.Lucro)</dd></div>
                }
            </dl>
            @if (!string.IsNullOrEmpty(Model.Observacao)) { <p class="mt-3 rounded-lg bg-slate-50 p-3 text-sm text-slate-600">@Model.Observacao</p> }
        </div>

        <div class="space-y-2">
            <a href="@Model.LinkRecibo" target="_blank" rel="noopener" class="btn-whatsapp w-full">@Icone.Svg("whatsapp") Enviar recibo no WhatsApp</a>
            <a href="/vendas/@Model.Id/recibo" class="btn-secundario w-full">@Icone.Svg("download", "w-4 h-4") Recibo em PDF</a>
            @if (dono && !cancelada)
            {
                <form method="post" asp-antiforgery="true" action="/vendas/@Model.Id/cancelar" data-confirmar="Cancelar a venda nº @Model.Id? O estoque volta e as parcelas em aberto são canceladas. Isso não pode ser desfeito.">
                    <button class="btn w-full border border-rose-200 bg-white text-rose-600 hover:bg-rose-50">@Icone.Svg("fechar", "w-4 h-4") Cancelar venda</button>
                </form>
            }
        </div>
    </div>
</div>
