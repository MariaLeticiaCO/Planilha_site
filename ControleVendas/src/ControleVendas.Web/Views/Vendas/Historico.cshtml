@model PaginaDto<VendaListaDto>
@{
    ViewData["Title"] = "Histórico de vendas";
    var filtro = (FiltroVendasDto)ViewBag.Filtro;
    var formas = (IReadOnlyList<FormaPagamentoDto>)ViewBag.Formas;
    var dono = User.IsInRole("DONO");
    string Url(int pagina) => $"?inicio={filtro.Inicio:yyyy-MM-dd}&fim={filtro.Fim:yyyy-MM-dd}&formaPagamentoId={filtro.FormaPagamentoId}&status={filtro.Status}&pagina={pagina}";
}
<div class="flex items-center justify-between gap-3">
    <div>
        <h1 class="titulo-pagina">Vendas</h1>
        <p class="subtitulo">@Model.TotalItens @(Model.TotalItens == 1 ? "venda encontrada" : "vendas encontradas")@(dono ? "" : " (só as suas)")</p>
    </div>
    <a href="/vendas/nova" class="btn-primario">@Icone.Svg("mais") <span class="hidden sm:inline">Nova venda</span></a>
</div>

<form method="get" class="card-p mt-4 grid grid-cols-2 gap-3 md:grid-cols-5 md:items-end" data-sem-trava>
    <div>
        <label class="rotulo" for="inicio">De</label>
        <input type="date" id="inicio" name="inicio" value="@filtro.Inicio?.ToString("yyyy-MM-dd")" class="campo" />
    </div>
    <div>
        <label class="rotulo" for="fim">Até</label>
        <input type="date" id="fim" name="fim" value="@filtro.Fim?.ToString("yyyy-MM-dd")" class="campo" />
    </div>
    <div>
        <label class="rotulo" for="formaPagamentoId">Pagamento</label>
        <select id="formaPagamentoId" name="formaPagamentoId" class="campo">
            <option value="">Todas</option>
            @foreach (var f in formas)
            {
                <option value="@f.Id" selected="@(filtro.FormaPagamentoId == f.Id)">@f.Nome</option>
            }
        </select>
    </div>
    <div>
        <label class="rotulo" for="status">Status</label>
        <select id="status" name="status" class="campo">
            <option value="">Todos</option>
            <option value="CONCLUIDA" selected="@(filtro.Status == StatusVenda.CONCLUIDA)">Concluídas</option>
            <option value="CANCELADA" selected="@(filtro.Status == StatusVenda.CANCELADA)">Canceladas</option>
        </select>
    </div>
    <button class="btn-suave col-span-2 md:col-span-1">@Icone.Svg("filtro", "w-4 h-4") Filtrar</button>
</form>

@if (Model.Itens.Count == 0)
{
    <div class="card mt-4 p-10 text-center text-slate-500">Nenhuma venda nesse filtro.</div>
}
else
{
    @* Celular: lista em cards *@
    <div class="card mt-4 divide-y divide-slate-100 md:hidden">
        @foreach (var v in Model.Itens)
        {
            <a href="/vendas/@v.Id" class="flex items-center justify-between gap-3 p-4 active:bg-slate-50">
                <div class="min-w-0">
                    <p class="truncate font-semibold">@(v.Cliente ?? "Venda nº " + v.Id)</p>
                    <p class="text-xs text-slate-500">@Exibir.DataHora(v.DataVenda) · @v.FormaPagamento</p>
                </div>
                <div class="shrink-0 text-right">
                    <p class="font-bold @(v.Status == StatusVenda.CANCELADA ? "text-slate-400 line-through" : "")">@Exibir.Moeda(v.Total)</p>
                    @if (v.Status == StatusVenda.CANCELADA) { <span class="chip-cinza">Cancelada</span> }
                    else if (v.Lucro is not null) { <p class="text-xs font-semibold text-emerald-600">lucro @Exibir.Moeda(v.Lucro)</p> }
                </div>
            </a>
        }
    </div>

    @* Computador: tabela *@
    <div class="card mt-4 hidden overflow-hidden md:block">
        <table class="tabela">
            <thead>
                <tr>
                    <th>Nº</th><th>Data</th><th>Cliente</th><th>Pagamento</th>
                    @if (dono) { <th>Vendedor</th> }
                    <th class="text-right">Total</th>
                    @if (dono) { <th class="text-right">Lucro</th> }
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var v in Model.Itens)
                {
                    <tr class="cursor-pointer" onclick="location.href='/vendas/@v.Id'">
                        <td class="text-slate-500">@v.Id</td>
                        <td>@Exibir.DataHora(v.DataVenda)</td>
                        <td>@(v.Cliente ?? "—")</td>
                        <td>@v.FormaPagamento</td>
                        @if (dono) { <td class="text-slate-500">@v.Vendedor</td> }
                        <td class="text-right font-semibold">@Exibir.Moeda(v.Total)</td>
                        @if (dono) { <td class="text-right font-semibold @(v.Lucro < 0 ? "text-rose-600" : "text-emerald-600")">@Exibir.Moeda(v.Lucro)</td> }
                        <td>@if (v.Status == StatusVenda.CANCELADA) { <span class="chip-cinza">Cancelada</span> } else { <span class="chip-verde">Concluída</span> }</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPaginas > 1)
    {
        <nav class="mt-4 flex items-center justify-between text-sm" aria-label="Paginação">
            @if (Model.Pagina > 1) { <a href="@Url(Model.Pagina - 1)" class="btn-secundario btn-sm">@Icone.Svg("esquerda", "w-4 h-4") Anterior</a> } else { <span></span> }
            <span class="text-slate-500">Página @Model.Pagina de @Model.TotalPaginas</span>
            @if (Model.Pagina < Model.TotalPaginas) { <a href="@Url(Model.Pagina + 1)" class="btn-secundario btn-sm">Próxima @Icone.Svg("direita", "w-4 h-4")</a> } else { <span></span> }
        </nav>
    }
}
