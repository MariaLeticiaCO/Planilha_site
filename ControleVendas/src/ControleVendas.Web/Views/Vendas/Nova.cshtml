@using System.Text.Json
@{
    ViewData["Title"] = "Nova venda";
    ViewData["SemNavInferior"] = true;
    var formas = (IReadOnlyList<FormaPagamentoDto>)ViewBag.Formas;
    var produtos = (IReadOnlyList<ProdutoVendaDto>)ViewBag.Produtos;
    var json = new JsonSerializerOptions(JsonSerializerDefaults.Web);
    json.Converters.Add(new System.Text.Json.Serialization.JsonStringEnumConverter());
    var dono = User.IsInRole("DONO");
}
<div class="mb-4 flex items-center gap-3">
    <a href="/painel" class="rounded-xl p-2 text-slate-500 hover:bg-slate-100 lg:hidden" aria-label="Voltar">@Icone.Svg("esquerda")</a>
    <h1 class="titulo-pagina">Nova venda</h1>
</div>

<div class="lg:grid lg:grid-cols-[1fr_400px] lg:items-start lg:gap-6">
    @* ===== Produtos ===== *@
    <section>
        <div class="sticky top-[57px] z-20 -mx-4 bg-slate-50/95 px-4 pb-3 pt-1 backdrop-blur lg:top-0 lg:mx-0 lg:px-0">
            <label class="relative block">
                <span class="pointer-events-none absolute inset-y-0 left-3.5 flex items-center text-slate-400">@Icone.Svg("busca")</span>
                <input id="busca-produto" type="search" class="campo pl-11" placeholder="Buscar produto por nome ou código" autocomplete="off" enterkeyhint="search" />
            </label>
        </div>
        <div id="lista-produtos" class="grid grid-cols-1 gap-2.5 sm:grid-cols-2 xl:grid-cols-3"></div>
        <p id="sem-produtos" class="oculto py-10 text-center text-slate-500">
            Nenhum produto encontrado.
            @if (dono) { <a href="/produtos/novo" class="font-semibold text-marca-700">Cadastrar produto</a> }
        </p>
    </section>

    @* ===== Carrinho e pagamento (painel lateral no computador, tela cheia no celular) ===== *@
    <section id="painel-carrinho" class="fixed inset-0 z-50 flex flex-col bg-slate-50 max-lg:hidden lg:sticky lg:top-6 lg:z-auto lg:max-h-[calc(100vh-3rem)] lg:rounded-2xl lg:border lg:border-slate-200 lg:bg-white lg:shadow-sm">
        <header class="flex items-center gap-3 border-b border-slate-200 bg-white px-4 py-3 lg:rounded-t-2xl">
            <button type="button" id="fechar-carrinho" class="rounded-xl p-2 text-slate-500 hover:bg-slate-100 lg:hidden" aria-label="Voltar aos produtos">@Icone.Svg("esquerda")</button>
            <h2 class="flex-1 font-bold">Carrinho <span id="carrinho-qtd" class="chip-marca ml-1">0</span></h2>
            <button type="button" id="limpar-carrinho" class="text-xs font-semibold text-slate-500 hover:text-rose-600">Limpar</button>
        </header>

        <div class="flex-1 space-y-4 overflow-y-auto p-4">
            <ul id="itens-carrinho" class="space-y-2"></ul>
            <p id="carrinho-vazio" class="rounded-xl border-2 border-dashed border-slate-200 p-6 text-center text-sm text-slate-500">Toque no <b>+</b> de um produto para começar.</p>

            <div id="bloco-pagamento" class="space-y-4">
                @* Desconto em R$ ou % *@
                <div>
                    <label for="desconto" class="rotulo">Desconto</label>
                    <div class="flex gap-2">
                        <input id="desconto" type="text" inputmode="decimal" class="campo" placeholder="0" autocomplete="off" />
                        <div class="segmentado shrink-0" id="tipo-desconto">
                            <button type="button" data-tipo="reais" class="ativo">R$</button>
                            <button type="button" data-tipo="percentual">%</button>
                        </div>
                    </div>
                </div>

                @* Forma de pagamento em botões grandes *@
                <div>
                    <p class="rotulo">Forma de pagamento</p>
                    <div class="grid grid-cols-2 gap-2" id="formas">
                        @foreach (var f in formas)
                        {
                            <button type="button" data-forma="@f.Id"
                                    class="flex items-center gap-2 rounded-xl border-2 border-slate-200 bg-white px-3 py-3 text-left text-sm font-semibold text-slate-700 transition hover:border-marca-300 [&.ativo]:border-marca-600 [&.ativo]:bg-marca-50 [&.ativo]:text-marca-800">
                                <span class="text-slate-400">@Icone.Svg(Exibir.IconeForma(f.Tipo))</span>
                                <span class="min-w-0 flex-1 truncate">@f.Nome</span>
                            </button>
                        }
                    </div>
                    @if (formas.Count == 0)
                    {
                        <p class="text-sm text-rose-600">Nenhuma forma de pagamento ativa. @(dono ? Html.Raw("<a class=\"underline\" href=\"/formas-pagamento\">Configure aqui</a>.") : Html.Raw("Peça ao dono para ativar."))</p>
                    }
                </div>

                @* Cliente (obrigatório no crediário) *@
                <div>
                    <label for="busca-cliente" class="rotulo"><span id="rotulo-cliente">Cliente (opcional)</span></label>
                    <div id="cliente-escolhido" class="oculto flex items-center justify-between gap-2 rounded-xl border border-marca-200 bg-marca-50 px-3 py-2.5">
                        <span class="min-w-0"><b class="block truncate text-sm" id="cliente-nome"></b><span class="text-xs text-slate-500" id="cliente-tel"></span></span>
                        <button type="button" id="trocar-cliente" class="text-xs font-semibold text-marca-700">Trocar</button>
                    </div>
                    <div id="cliente-busca" class="relative">
                        <input id="busca-cliente" type="search" class="campo" placeholder="Buscar por nome ou telefone" autocomplete="off" />
                        <ul id="sugestoes-cliente" class="oculto absolute inset-x-0 top-full z-10 mt-1 max-h-60 overflow-y-auto rounded-xl border border-slate-200 bg-white py-1 shadow-lg"></ul>
                    </div>
                    <button type="button" id="abrir-cliente-rapido" class="mt-1.5 text-xs font-semibold text-marca-700">+ Cadastrar cliente novo</button>
                    <div id="cliente-rapido" class="oculto mt-2 space-y-2 rounded-xl border border-slate-200 bg-white p-3">
                        <input id="rapido-nome" class="campo" placeholder="Nome do cliente" autocomplete="off" />
                        <input id="rapido-telefone" class="campo" placeholder="WhatsApp com DDD" inputmode="tel" data-mascara="telefone" autocomplete="off" />
                        <div class="flex gap-2">
                            <button type="button" id="cancelar-cliente-rapido" class="btn-secundario btn-sm flex-1">Cancelar</button>
                            <button type="button" id="salvar-cliente-rapido" class="btn-primario btn-sm flex-1">Salvar cliente</button>
                        </div>
                    </div>
                </div>

                @* Crediário: parcelas e 1º vencimento *@
                <div id="bloco-crediario" class="oculto grid grid-cols-2 gap-3 rounded-xl bg-white p-3 ring-1 ring-slate-200">
                    <div>
                        <label for="parcelas" class="rotulo">Parcelas</label>
                        <select id="parcelas" class="campo">
                            @for (var i = 1; i <= 12; i++) { <option value="@i">@(i)x</option> }
                        </select>
                    </div>
                    <div>
                        <label for="vencimento" class="rotulo">1º vencimento</label>
                        <input id="vencimento" type="date" class="campo" value="@DateTime.Today.AddDays(30).ToString("yyyy-MM-dd")" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    </div>
                    <p class="col-span-2 text-xs text-slate-500" id="info-parcelas"></p>
                </div>
            </div>
        </div>

        @* Resumo e finalizar *@
        <footer class="pb-seguro border-t border-slate-200 bg-white p-4 lg:rounded-b-2xl">
            <dl class="space-y-1 text-sm">
                <div class="flex justify-between text-slate-500"><dt>Subtotal</dt><dd id="resumo-subtotal">R$ 0,00</dd></div>
                <div class="flex justify-between text-slate-500" id="linha-desconto"><dt>Desconto</dt><dd id="resumo-desconto">− R$ 0,00</dd></div>
                <div class="flex justify-between text-slate-500"><dt>Taxa estimada</dt><dd id="resumo-taxa">R$ 0,00</dd></div>
                <div class="flex items-baseline justify-between pt-1"><dt class="font-semibold">Total</dt><dd class="text-2xl font-extrabold" id="resumo-total">R$ 0,00</dd></div>
                @if (dono)
                {
                    <div class="flex justify-between rounded-lg bg-emerald-50 px-3 py-1.5 font-semibold text-emerald-700"><dt>Lucro desta venda</dt><dd id="resumo-lucro">R$ 0,00</dd></div>
                }
            </dl>
            <button type="button" id="finalizar" class="btn-primario btn-lg mt-3 w-full" disabled>Finalizar venda</button>
        </footer>
    </section>
</div>

@* Barra inferior do celular: abre o carrinho *@
<div id="barra-carrinho" class="pb-seguro fixed inset-x-0 bottom-0 z-40 border-t border-slate-200 bg-white p-3 lg:hidden">
    <button type="button" id="abrir-carrinho" class="btn-primario btn-lg w-full justify-between" disabled>
        <span class="flex items-center gap-2">@Icone.Svg("carrinho") <span id="barra-qtd">Carrinho vazio</span></span>
        <span id="barra-total" class="font-extrabold">R$ 0,00</span>
    </button>
</div>
<div class="h-20 lg:hidden"></div>

@* Tela de sucesso *@
<div id="sucesso" class="oculto fixed inset-0 z-[60] flex items-center justify-center bg-slate-900/50 p-4" role="dialog" aria-modal="true" aria-labelledby="sucesso-titulo">
    <div class="w-full max-w-sm rounded-3xl bg-white p-6 text-center shadow-2xl">
        <span class="mx-auto inline-flex h-16 w-16 items-center justify-center rounded-full bg-emerald-100 text-emerald-600">@Icone.Svg("check", "w-9 h-9")</span>
        <h2 id="sucesso-titulo" class="mt-3 text-xl font-extrabold">Venda registrada!</h2>
        <p class="mt-1 text-3xl font-extrabold text-slate-900" id="sucesso-total"></p>
        <p class="mt-1 font-semibold text-emerald-600" id="sucesso-lucro"></p>
        <ul id="sucesso-avisos" class="mt-3 space-y-1 text-left text-xs text-amber-800"></ul>
        <div class="mt-5 space-y-2">
            <a id="sucesso-recibo" href="#" target="_blank" rel="noopener" class="btn-whatsapp btn-lg w-full">@Icone.Svg("whatsapp") Enviar recibo no WhatsApp</a>
            <button type="button" id="sucesso-nova" class="btn-primario btn-lg w-full">@Icone.Svg("mais") Nova venda</button>
            <a id="sucesso-ver" href="#" class="btn-secundario w-full">Ver detalhes</a>
        </div>
    </div>
</div>

@section Scripts {
<script>
    window.PDV = {
        produtos: @Html.Raw(JsonSerializer.Serialize(produtos, json)),
        formas: @Html.Raw(JsonSerializer.Serialize(formas, json)),
        dono: @(dono ? "true" : "false")
    };
</script>
<script src="~/js/venda.js" asp-append-version="true"></script>
}
