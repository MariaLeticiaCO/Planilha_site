# ===== Banco =====
# PostgreSQL. Na Vercel, a integração Neon (Storage → Neon) cria esta variável sozinha.
DATABASE_URL=postgres://usuario:senha@servidor/banco?sslmode=require
# Opcional: forçar o banco (postgres | mssql | sqlite). Sem ela, usa o PostgreSQL da DATABASE_URL.
# DATABASE_PROVIDER=
# Para usar SQL Server em vez do PostgreSQL:
# DATABASE_PROVIDER=mssql
# SQLSERVER_CONNECTION_STRING="Server=tcp:SEU-SERVIDOR.database.windows.net,1433;Initial Catalog=ControleVendas;User ID=SEU_USUARIO;Password=SUA_SENHA;Encrypt=True"

# ===== Sessão =====
# Gere com: openssl rand -base64 48
SESSION_SECRET=

# ===== URL pública (links dos e-mails). Na Vercel é detectada sozinha. =====
APP_URL=

# ===== Pagamento do SaaS (Asaas). Sem chave = gateway simulado. =====
ASAAS_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# ===== E-mail (Brevo ou SendGrid). Sem SMTP_HOST, o e-mail vai para o log. =====
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=nao-responda@seudominio.com.br
SMTP_FROM_NAME=Controle de Vendas

# ===== Fotos de produtos e logos (Vercel Blob). Criado automaticamente ao ligar o Blob no projeto. =====
BLOB_READ_WRITE_TOKEN=
