# ===== Banco =====
# mssql = SQL Server / Azure SQL (produção). sqlite = só demonstração local.
DATABASE_PROVIDER=mssql
# Connection string no formato ADO.NET (como o portal do Azure mostra):
SQLSERVER_CONNECTION_STRING="Server=tcp:SEU-SERVIDOR.database.windows.net,1433;Initial Catalog=ControleVendas;User ID=SEU_USUARIO;Password=SUA_SENHA;Encrypt=True;TrustServerCertificate=False"
# (ou, em vez da connection string: SQLSERVER_HOST, SQLSERVER_PORT, SQLSERVER_DATABASE, SQLSERVER_USER, SQLSERVER_PASSWORD)

# ===== Sessão =====
# Gere com: openssl rand -base64 48
SESSION_SECRET=

# ===== URL pública (links dos e-mails). Na Vercel é detectada sozinha. =====
APP_URL=

# ===== Pagamento do SaaS (Asaas). Sem chave = gateway simulado. =====
ASAAS_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# ===== E-mail (Brevo ou SendGrid). Sem SMTP_HOST, o e-mail vai para o log. =====
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=nao-responda@seudominio.com.br
SMTP_FROM_NAME=Controle de Vendas

# ===== Fotos de produtos e logos (Vercel Blob). Criado automaticamente ao ligar o Blob no projeto. =====
BLOB_READ_WRITE_TOKEN=
